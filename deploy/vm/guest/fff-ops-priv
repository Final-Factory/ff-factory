#!/usr/bin/env bash
# fff-ops-priv (w597, docs/ops-worker.md): what the orchestration worker may do as root in the portal VM, and nothing
# more. Its PATH's fffctl (ops-bin/fffctl) runs `sudo -n /usr/local/lib/fff/fff-ops-priv ARGS`; sudoers lets fff-ops run
# this one file as root.
#
#   fffctl status                      the portal, its release, health, Tailscale, backups (fffctl status)
#   fffctl state                       what is set up, as JSON (fffctl state)
#   fffctl units [--check]             the critical units: active, enabled, the watchdog's verdict and its last restarts (fffctl
#                                      units). --check prints "down: ..." and exits 1 if one is not (w743); read only, and no
#                                      other word: `fffctl watchdog` (run, pause, resume, reset) and the restarts stay a person's
#   fffctl vault list [--names]        the token vault's entries (name, kind, env, last four characters, fingerprint, grants), the
#                                      Claude pools' meters, or only the names (w745). Never a value. `vault help` prints the
#                                      vault command's own usage. `vault init`, `export-key`, `add`, `put`, `rotate`, `grant`,
#                                      `remove` and `new-key` change the vault or copy its key: a person's.
#   fffctl machine-credential list     the same as `credential list`, under fffctl's own name (w745)
#   fffctl migrate --help              migrate's usage (w745); `--key` (it trusts a new host key), `--dry-run-copy`,
#                                      `--rollback-dry-run` and `--cut-over` change state: a person's
#   fffctl logs [N]                    the portal's last N journal lines (default 200, at most 2000), secrets redacted
#   fffctl machine-ssh --check         the portal's ssh to each machine, then its authorized_keys line (fff-machine-ssh
#                                      --check, read only; machine-ssh-check is the same). Its PATH's fff-machine-ssh
#                                      (ops-bin/fff-machine-ssh) comes here too, so `fff-machine-ssh --check` works (w676)
#   fffctl machine-ssh --key           only the portal's authorized_keys line, from="<its tailnet IP>",... (public)
#   fffctl machine-ssh --pin USER@HOST FINGERPRINT
#                                      pin a new machine's host key in the portal's ssh (w676): only when the key HOST
#                                      shows over the tailnet is FINGERPRINT, read on the machine itself, and nothing
#                                      pins HOST yet. A changed key (machines.ssh), --fix and --data stay a person's.
#   fffctl credential list             the machines that hold a credential
#   fffctl credential issue ID --to TARGET
#                                      a new /machine credential for machine ID, written straight into a file on TARGET
#                                      over the portal's ssh (~/.ff-factory/machine-credential-ID there; on Windows under
#                                      %USERPROFILE%). Never printed: only the remote path and its last four characters.
#                                      ID must have a machine record (adding one is a person's: add_machine, w676), and
#                                      TARGET must answer ssh first; issuing replaces the machine's credential, so its
#                                      running daemon is dropped within 20 s.
#   fffctl update                      the portal deploy (fffctl update --no-wait: build origin/main beside, drain,
#                                      restart, verify, roll back by itself), only with the grant the portal leaves in
#                                      its data folder when Lothsahn or Ben asks for a deploy in a turn of their own
#                                      (ops_worker deploy): good for 15 minutes, once, removed here before anything runs.
#                                      No options: no other ref, no drain setting.
#
# Everything else fffctl does (restart, rollback, configure, the vault, tokens, migrate, backups, shutdown) is a
# person's and is not here. Every call is logged to the journal (tag fff-ops-priv); sudo logs it too.
set -o errexit -o nounset -o pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
FFF_LIB=${FFF_LIB:-/usr/local/lib/fff}
refuse() { echo "fffctl (orchestration worker): $*" >&2; exit 2; }
[ "$(id -u)" -eq 0 ] || refuse "run through sudo (the worker's fffctl does it)"
FFFCTL=${FFFCTL:-/usr/local/sbin/fffctl} # overridable like FFF_LIB; sudo's env_reset drops it for the real worker
# shellcheck source=lib.sh
. "$FFF_LIB/lib.sh"
load_conf
logger -t fff-ops-priv -- "fffctl $*" 2>/dev/null || true

# The patterns redactSecrets (server/secrets.ts) knows, for log lines.
redact() {
  sed -E -e 's/sk-ant-oat01-[A-Za-z0-9_-]{40,}/sk-ant-oat01-[redacted]/g' -e 's/sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{40,}/sk-ant-api-[redacted]/g' \
    -e 's/(ffm_[A-Za-z0-9.-]{1,64}_)[A-Za-z0-9_-]{32,}/\1[redacted]/g' -e 's/(gh[pousr]_|github_pat_)[A-Za-z0-9_]{30,}/\1[redacted]/g' \
    -e 's/ffpv1_[A-Za-z0-9_-]{10,}/ffpv1_[redacted]/g' -e 's/tskey-[a-z]+-[A-Za-z0-9-]{16,}/tskey-[redacted]/g'
}

ssh_as_fff() { runuser -u "$FFF_USER" -- "$FFF_LIB/fff-ops-ssh" "$@"; }
# fff-machine-ssh as the portal's account, with the installed machines.ssh (it refuses root). It reads and writes only
# the portal account's ~/.ssh; it prints the public key line, never the private key.
machine_ssh() { runuser -u "$FFF_USER" -- env HOME="$FFF_ROOT/home" "$FFF_LIB/fff-machine-ssh" "$@"; }

credential_issue() {
  local id=$1 target=$2 tmp platform remote enc ps out
  [[ $id =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || refuse "not a machine id: '${id:0:80}'"
  # Reach it first: a credential issued for a machine we then cannot write to would only cut its daemon off.
  out=$(ssh_as_fff "$target" uname -s </dev/null 2>/dev/null || true)
  case "$out" in
    Darwin* | Linux*) platform=posix ;;
    *)
      out=$(ssh_as_fff "$target" 'echo %OS%' </dev/null 2>&1) || refuse "$target does not answer ssh: ${out:0:300}"
      platform=windows
      ;;
  esac
  # A record (w676): the installer's credential check (GET /machine/whoami) and the daemon's link need one, and
  # adding it is a person's. Without this, the credential would be issued for nothing.
  jq -e --arg id "${id,,}" 'any((.machines // [])[]; .id == $id)' "$DATA/state.json" >/dev/null 2>&1 ||
    refuse "the portal has no machine record '${id,,}': adding one is a person's. Ask your person to have the dispatcher run add_machine ${id,,} with worker_install (docs/ops-worker.md, \"A new machine\"); list_machines shows it once it is there"
  tmp=$(mktemp -d)
  # $tmp is local: a single-quoted trap would expand it at exit, after this function returned, and `set -u` would end
  # the script with "tmp: unbound variable" (exit 1) after the credential was already stored (w734).
  # shellcheck disable=SC2064 # expanded now, on purpose
  trap "rm -rf -- '$tmp'" EXIT
  "$FFFCTL" machine-credential issue "$id" --out "$tmp/cred" >"$tmp/issued" 2>&1 || refuse "fffctl machine-credential issue $id failed: $(redact <"$tmp/issued" | tail -n 3)"
  remote="machine-credential-$id"
  if [ "$platform" = posix ]; then
    out=$(ssh_as_fff "$target" "umask 077 && mkdir -p ~/.ff-factory && cat > ~/.ff-factory/$remote && chmod 600 ~/.ff-factory/$remote && echo stored ~/.ff-factory/$remote" <"$tmp/cred" 2>&1) ||
      refuse "the credential was issued but could not be written on $target: ${out:0:300}. The machine's old credential no longer works; run this again"
  else
    # Base64 UTF-16LE (-EncodedCommand) so cmd.exe or PowerShell as the ssh shell pass it on unchanged.
    ps="\$d = Join-Path \$env:USERPROFILE '.ff-factory'; New-Item -ItemType Directory -Force -Path \$d | Out-Null; \$f = Join-Path \$d '$remote'; [IO.File]::WriteAllText(\$f, [Console]::In.ReadToEnd().Trim()); 'stored ' + \$f"
    enc=$(printf '%s' "$ps" | iconv -t UTF-16LE | base64 -w0)
    out=$(ssh_as_fff "$target" "powershell -NoProfile -NonInteractive -EncodedCommand $enc" <"$tmp/cred" 2>&1) ||
      refuse "the credential was issued but could not be written on $target: ${out:0:300}. The machine's old credential no longer works; run this again"
  fi
  redact <"$tmp/issued" | sed -E 's/ is in [^ ]+ \(0600\)/ was issued/; s/ Move it to the machine, then delete [^ ]+\.$//'
  echo "on $target: $(printf '%s' "$out" | tr -d '\r' | tail -n 1) (give it to the worker installer with --credential-file / -CredentialFile, then delete it there)"
}

case "${1:-help}" in
  status) exec "$FFFCTL" status ;;
  state) exec "$FFFCTL" state ;;
  units)
    # Read only (cmd_units): the table, or the check's exit status. Exactly these two forms; a unit's change is a person's.
    case "${2:-}" in
      "") [ $# -eq 1 ] || refuse "units takes nothing more"; exec "$FFFCTL" units ;;
      --check) [ $# -eq 2 ] || refuse "units --check takes nothing more"; exec "$FFFCTL" units --check ;;
      *) refuse "units | units --check (the watchdog, restarts and pauses are a person's: sudo fffctl watchdog)" ;;
    esac
    ;;
  vault)
    # Read only (w745): the entries' metadata and the usage text. Exactly these three forms, nothing after them.
    case "${2:-}" in
      list)
        if [ $# -eq 2 ]; then exec "$FFFCTL" vault list; fi
        [ $# -eq 3 ] && [ "$3" = --names ] || refuse "vault list [--names] takes nothing more"
        exec "$FFFCTL" vault list --names
        ;;
      help) [ $# -eq 2 ] || refuse "vault help takes nothing more"; exec "$FFFCTL" vault help ;;
      *) refuse "vault list [--names] | vault help (init, export-key, add, put, rotate, grant, remove and new-key change the vault or copy its key: a person's, sudo fffctl vault ...)" ;;
    esac
    ;;
  machine-credential)
    [ $# -eq 2 ] && [ "$2" = list ] || refuse "machine-credential list (issue and revoke are a person's; credential issue ID --to TARGET is yours, with a record)"
    exec "$FFFCTL" machine-credential list
    ;;
  migrate)
    [ $# -eq 2 ] && [ "$2" = --help ] || refuse "migrate --help (the migration itself, and migrate --key, which trusts a new host key, are a person's)"
    exec "$FFFCTL" migrate --help
    ;;
  logs)
    n=${2:-200}
    if ! [[ $n =~ ^[0-9]{1,4}$ ]] || [ "$n" -lt 1 ] || [ "$n" -gt 2000 ]; then refuse "logs [N]: N from 1 to 2000"; fi
    journalctl -u fff-portal.service -n "$n" --no-pager -o short-iso | redact
    ;;
  machine-ssh-check) [ $# -eq 1 ] || refuse "machine-ssh-check takes nothing more"; machine_ssh --check ;;
  machine-ssh)
    # Only these, never --fix (machines.ssh's, at a deploy) or --data (a file of the worker's would be pinned).
    case "${2:-}" in
      --check | --key) [ $# -eq 2 ] || refuse "machine-ssh $2 takes nothing more"; machine_ssh "$2" ;;
      --pin) [ $# -eq 4 ] || refuse "machine-ssh --pin USER@HOST FINGERPRINT (SHA256:..., read on the machine itself)"; machine_ssh --pin "$3" "$4" ;;
      *) refuse "machine-ssh --check | --key | --pin USER@HOST FINGERPRINT (--fix and a changed key are a person's: machines.ssh and a deploy)" ;;
    esac
    ;;
  credential)
    case "${2:-}" in
      list) exec "$FFFCTL" machine-credential list ;;
      issue)
        if [ $# -ne 5 ] || [ "$4" != --to ]; then refuse "credential issue ID --to TARGET"; fi
        credential_issue "$3" "$5"
        ;;
      *) refuse "credential list | credential issue ID --to TARGET (revoking is a person's: sudo fffctl machine-credential revoke)" ;;
    esac
    ;;
  update)
    if [ $# -ne 1 ]; then refuse "update takes no options: it builds origin/$FFF_BRANCH"; fi
    grant=$DATA/ops-deploy.grant
    [ -f "$grant" ] || refuse "no deploy was asked for: only Lothsahn or Ben ask for one, in a turn of their own, through their orchestrator's ops_worker deploy (good for 15 minutes, once)"
    owner=$(stat -c %U "$grant")
    by=$(jq -r '.by // ""' "$grant" 2>/dev/null || true)
    expires=$(jq -r '.expires // ""' "$grant" 2>/dev/null || true)
    # Used once, whatever follows.
    rm -f "$grant"
    [ "$owner" = "$FFF_USER" ] || refuse "the deploy grant is not the portal's ($owner): refused"
    if [ -z "$by" ] || [ "$(date -d "$expires" +%s 2>/dev/null || echo 0)" -le "$(date +%s)" ]; then refuse "the deploy grant ran out (${expires:-no time}): ask your person to ask for the deploy again"; fi
    before=$(release_sha "$(readlink -e "$CURRENT" 2>/dev/null || true)")
    logger -t fff-ops-priv -- "deploy asked for by $by: fffctl update from ${before:-unknown}" 2>/dev/null || true
    echo "deploy asked for by $by; the portal runs $(basename "$(readlink -e "$CURRENT" 2>/dev/null || echo none)") at commit ${before:-unknown}"
    "$FFFCTL" update --no-wait
    echo "asked for: the portal builds origin/$FFF_BRANCH beside the running release, drains, restarts on it, verifies it and rolls back by itself. Your process ends with the old portal; FF Factory messages you when the new one is up."
    ;;
  help | -h | --help) awk 'NR > 5 && /^#$/ {exit} NR > 5' "$0" | sed 's/^# \{0,1\}//' ;;
  *) refuse "fffctl $1 is a person's (restarts, rollbacks, settings, the vault, migrations). You have: status, state, units [--check], vault list [--names] / vault help, machine-credential list, migrate --help, logs [N], machine-ssh --check / --key / --pin USER@HOST FINGERPRINT, credential list, credential issue ID --to TARGET, and update with a deploy grant" ;;
esac
