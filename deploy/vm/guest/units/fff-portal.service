[Unit]
Description=FF Factory portal (deploy/vm/guest)
Documentation=https://github.com/Final-Factory/ff-factory/blob/main/docs/portal-on-ffbox-host.md
After=network-online.target fff-guest-firewall.service
Wants=network-online.target
# Never give up: a server that keeps exiting is restarted every RestartSec, as supervise.ps1 did.
StartLimitIntervalSec=0

[Service]
Type=simple
User=fff
Group=fff
UMask=0077
Environment=FFSB_SUPERVISOR=systemd
Environment=FFSB_CONFIG=/srv/fff/config/config.json
Environment=NODE_ENV=production
# Its agents start as fff-agent through this socket (w5598, server/agentAccount.ts); without it, as fff, with an alert.
Environment=FFF_AGENT_SOCKET=/run/fff-agent/claude.sock
Environment=HOME=/srv/fff/home
Environment=PATH=/srv/fff/home/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/srv/fff/app/current
# fffctl prepare-shutdown (the host's nightly restart): stay stopped until the next boot.
ExecCondition=/bin/sh -c '! test -e /run/fff/portal.hold'
# As root ("+"): switch to the release fff-update prepared when the server left data/update.request.
ExecStartPre=+/usr/local/lib/fff/fff-update activate
# As root, never failing the start: the orchestration worker's Claude Code is this release's Agent SDK's (w597).
ExecStartPre=-+/usr/local/lib/fff/fff-ops-sync
# As root, never failing the start (w5506): node, copied execute-only (0111, root's) for this service alone. A process that
# runs a binary it may not read is not dumpable, so its /proc/<pid>/environ, mem and fd are root's: no other process of
# the fff account, an agent's tool included, reads the portal's memory or the vault key in it. The copy follows apt's node
# at every start; without one the start fails below, never runs a readable node.
ExecStartPre=-+/bin/sh -c 'cmp -s /usr/bin/node /usr/local/lib/fff/node-portal || { install -o root -g root -m 0111 /usr/bin/node /usr/local/lib/fff/node-portal.new && mv -f /usr/local/lib/fff/node-portal.new /usr/local/lib/fff/node-portal; }'
# --disable-sigusr1: a SIGUSR1, which any fff process may send, would open the inspector to the portal's memory.
ExecStart=/usr/local/lib/fff/node-portal --disable-sigusr1 server/index.ts
Restart=always
RestartSec=3
# Covers an update built at start (one a crash cut off) and the server's own startup.
TimeoutStartSec=20min
# SIGTERM to the server only: it records what to resume and stops its agents itself (server/index.ts stopServer);
# whatever is left after TimeoutStopSec is killed.
KillMode=mixed
TimeoutStopSec=75
LimitNOFILE=65536
# The token vault's key (docs/vault.md, w512): root's file, opened by systemd and handed to the server as a descriptor
# (OpenFile=, systemd 253+), which it reads and closes before it starts anything (server/vault.ts takeOpenedKey). Unlike
# LoadCredential= (before w5506), nothing on disk holds the key for the fff account to read. install.sh makes the key
# before it installs this unit; without it the portal does not start, as it never did.
OpenFile=/etc/fff/vault.key:fff-vault-key:read-only
NoNewPrivileges=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
