[Unit]
Description=FF Factory portal VM: its own nftables table (inet fff_guest only)
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target fff-portal.service tailscaled.service shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target
# A failed load is tried again (w698): 5 times in 10 minutes, then fff-health (every 30 s) takes over with its back-off.
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/fff/guest.nft
ExecReload=/usr/sbin/nft -f /etc/fff/guest.nft
ExecStop=-/usr/sbin/nft delete table inet fff_guest
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
