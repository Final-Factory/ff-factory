#!/usr/bin/env bash
# fff-backup: the portal's encrypted backup, off the FFBox host (fff-backup.timer, daily; root).
#
# config, data, agents, home (ssh keys, gh and ffdiscord settings) and secrets (the subscription token), optionally review media, as
# one tar.gz encrypted with age to BACKUP_RECIPIENTS_FILE's public keys, whose private keys are kept off the FFBox
# host: neither the host nor this VM can open a backup. Sent with sftp to BACKUP_SSH_TARGET (e.g. an account on BEAST
# over the tailnet) with its own key, BACKUP_KEEP newest kept there.
#
# Restore, with the portal stopped (fffctl prepare-shutdown):
#   age -d -i key.txt fff-<host>-<time>.tar.gz.age | tar -xz -C /srv/fff && chown -R fff:fff /srv/fff
set -o errexit -o nounset -o pipefail
# shellcheck source=lib.sh
. "${FFF_LIB:-/usr/local/lib/fff}/lib.sh"
need_root
load_conf

fail() {
  log "backup FAILED: $1"
  tell_dispatcher "[backup] The portal's daily backup failed: $1. (journalctl -u fff-backup in the VM)"
  exit 1
}
if [ -z "$BACKUP_SSH_TARGET" ]; then log "backups are off (BACKUP_SSH_TARGET is empty in $FFF_CONF)"; exit 0; fi
[ -s "$BACKUP_RECIPIENTS_FILE" ] || fail "no age public keys in $BACKUP_RECIPIENTS_FILE"
[ -r "$BACKUP_SSH_KEY" ] || fail "no ssh key $BACKUP_SSH_KEY"

name="fff-$(hostname -s)-$(date -u +%Y%m%dT%H%M%SZ).tar.gz.age"
stage=$FFF_ROOT/backup
install -d -m 0700 "$stage"
out=$stage/$name
parts=(config data agents home secrets)
[ "$BACKUP_INCLUDE_REVIEW" != yes ] || parts+=(review)
existing=()
for p in "${parts[@]}"; do [ ! -e "$FFF_ROOT/$p" ] || existing+=("$p"); done
log "archiving ${existing[*]} to $out"
set +o pipefail
tar -C "$FFF_ROOT" --warning=no-file-changed --exclude=home/.cache --exclude=home/.npm --exclude=home/.local/share/claude/versions \
  -czf - "${existing[@]}" | age -R "$BACKUP_RECIPIENTS_FILE" -o "$out"
codes=("${PIPESTATUS[@]}")
set -o pipefail
# GNU tar exits 1 when a file changed while it was read (a live server's data): still a usable backup.
if [ "${codes[0]}" -gt 1 ] || [ "${codes[1]}" -ne 0 ]; then
  rm -f "$out"
  fail "tar exited ${codes[0]}, age ${codes[1]}"
fi
size=$(du -h "$out" | cut -f1)

sftp_b() { sftp -q -b - -i "$BACKUP_SSH_KEY" -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/etc/fff/backup_known_hosts "$BACKUP_SSH_TARGET"; }
printf -- '-mkdir %s\nput %s %s/%s.part\nrename %s/%s.part %s/%s\n' "$BACKUP_REMOTE_DIR" "$out" "$BACKUP_REMOTE_DIR" "$name" \
  "$BACKUP_REMOTE_DIR" "$name" "$BACKUP_REMOTE_DIR" "$name" | sftp_b >/dev/null || { rm -f "$out"; fail "sftp upload to $BACKUP_SSH_TARGET failed"; }
rm -f "$out"
log "sent $name ($size) to $BACKUP_SSH_TARGET:$BACKUP_REMOTE_DIR"

# Keep the newest BACKUP_KEEP.
old=$(printf 'ls -1 %s\n' "$BACKUP_REMOTE_DIR" | sftp_b 2>/dev/null | sed 's:.*/::' | grep -E '^fff-.*\.tar\.gz\.age$' | sort | head -n "-$BACKUP_KEEP" || true)
if [ -n "$old" ]; then
  printf '%s\n' "$old" | sed "s:^:rm $BACKUP_REMOTE_DIR/:" | sftp_b >/dev/null || warn "pruning old backups failed"
  log "removed $(printf '%s\n' "$old" | wc -l) old backup(s) there"
fi
