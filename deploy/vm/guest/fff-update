#!/usr/bin/env bash
# fff-update: the portal VM's updater (deploy/vm/guest; /usr/local/lib/fff/fff-update), in place of supervise.ps1,
# update.ps1 and update-steps.ps1. Root; git and npm run as fff.
#
# Releases are git worktrees of one bare clone, $FFF_ROOT/app/releases/<sha12>, each with its own node_modules and
# web build; $FFF_ROOT/app/current is the one fff-portal.service runs, previous the one before it. So the new code is
# built while the old one runs, and the switch at the restart takes a second.
#
#   fff-update request       fff-update.path started it: data/update.wanted is there (request_app_update or
#                            "fffctl update"). Builds origin/<branch>, then asks the server for the drain and the
#                            restart (restart.request with update: true); the server leaves data/update.request
#                            and exits, and the next start switches.
#   fff-update activate      fff-portal.service's ExecStartPre (as root): if data/update.request is there, switch to
#                            the prepared release (or build one now: an update cut off by a crash), record the result
#                            for the server's restart summary, and start verifying it.
#   fff-update verify        fff-health calls it: once the new code answers /api/health with its SHA the update is
#                            done; past UPDATE_VERIFY_MIN minutes without that, roll back.
#   fff-update rollback [WHY] back to the previous release, restart.
#   fff-update prepare [REF] build REF (default origin/<branch>) and print the release folder.
#   fff-update init [REF]    the first release (install.sh).
set -o errexit -o nounset -o pipefail
# shellcheck source=lib.sh
. "${FFF_LIB:-/usr/local/lib/fff}/lib.sh"
need_root
load_conf
# The verify window in seconds: UPDATE_VERIFY_SEC when set (CI's test mode), else UPDATE_VERIFY_MIN minutes.
verify_secs() { echo "${UPDATE_VERIFY_SEC:-$((UPDATE_VERIFY_MIN * 60))}"; }

current_dir() { readlink -e "$CURRENT" 2>/dev/null || true; }

# deps_from OLD NEW SUB: NEW/SUB/node_modules as hard links of OLD's when SUB's package.json and package-lock.json are
# the same in both, which is what npm ci would install anyway (seconds instead of half a minute). The caches tools write
# into node_modules are left out, so nothing writes through a link into the running release's files.
deps_from() {
  local old=$1 new=$2 sub=$3 f
  [ -n "$old" ] && [ -f "$old.ready" ] && [ -d "$old/$sub/node_modules" ] || return 1
  for f in package.json package-lock.json; do cmp -s "$old/$sub/$f" "$new/$sub/$f" || return 1; done
  rm -rf "$new/$sub/node_modules"
  as_fff cp -al "$old/$sub/node_modules" "$new/$sub/node_modules" || { rm -rf "$new/$sub/node_modules"; return 1; }
  rm -rf "$new/$sub/node_modules/.cache" "$new/$sub/node_modules/.vite" "$new/$sub/node_modules/.tmp"
}

# prepare [REF]: build REF beside the running release and print its folder. Every step is checked here: this runs in
# $(...) and under "if", where bash ignores errexit, so a failed npm ci would otherwise still mark the release ready.
prepare() {
  local ref=${1:-origin/$FFF_BRANCH} sha dir cur sub t
  log "fetching $ref"
  t=$(date +%s)
  as_fff git -C "$REPO" fetch --prune --quiet origin >&2 || die "git fetch of $FFF_REPO_URL failed"
  sha=$(as_fff git -C "$REPO" rev-parse --verify --quiet "$ref^{commit}") || die "no commit $ref in $FFF_REPO_URL"
  dir=$RELEASES/${sha:0:12}
  log "fetched ${sha:0:12} in $(($(date +%s) - t)) s"
  if [ -f "$dir.ready" ] && [ -e "$dir/.git" ]; then
    log "release ${sha:0:12} is already built"
    echo "$dir"
    return 0
  fi
  log "building ${sha:0:12} ($ref) in $dir"
  t=$(date +%s)
  rm -f "$dir.ready"
  if [ -e "$dir" ]; then as_fff git -C "$REPO" worktree remove --force "$dir" >&2 2>/dev/null || rm -rf "$dir"; fi
  as_fff git -C "$REPO" worktree prune >&2 || true
  as_fff git -C "$REPO" worktree add --detach --quiet "$dir" "$sha" >&2 || die "git worktree add $dir failed"
  cur=$(current_dir)
  for sub in . web; do
    if [ "$cur" != "$dir" ] && deps_from "$cur" "$dir" "$sub"; then
      log "building ${sha:0:12}: $sub dependencies unchanged, node_modules reused from $(basename "$cur")"
    else
      log "building ${sha:0:12}: npm ci ($sub)"
      as_fff_in "$dir/$sub" npm ci --no-audit --no-fund --loglevel=error >&2 || die "npm ci in $sub failed"
    fi
  done
  log "building ${sha:0:12}: web build"
  as_fff_in "$dir" npm --prefix web run build --silent >&2 || die "the web build failed"
  as_fff touch "$dir.ready" || die "could not mark $dir ready"
  log "release ${sha:0:12} built in $(($(date +%s) - t)) s"
  echo "$dir"
}

# Keep current, previous, the prepared one and RELEASES_KEEP_EXTRA more (newest first).
prune() {
  local keep cur prev prepared d n=0
  cur=$(current_dir); prev=$(readlink -e "$PREVIOUS" 2>/dev/null || true)
  prepared=$(jq -r '.dir // empty' "$DATA/update.prepared.json" 2>/dev/null || true)
  keep=" $cur $prev $prepared "
  for d in $(find "$RELEASES" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p
' | sort -rn | cut -d' ' -f2-); do
    case "$keep" in *" $d "*) continue ;; esac
    n=$((n + 1))
    [ "$n" -gt "$RELEASES_KEEP_EXTRA" ] || continue
    log "removing old release $(basename "$d")"
    as_fff git -C "$REPO" worktree remove --force "$d" 2>/dev/null || rm -rf "$d"
    rm -f "$d.ready"
  done
  as_fff git -C "$REPO" worktree prune
}

# refresh_scripts DIR: fffctl and the helper scripts from release DIR (install_scripts), so they move with the portal's
# code: forward on an update, back on a rollback. A unit that changed needs install.sh (it reloads systemd): said so.
refresh_scripts() {
  local src=$1/deploy/vm/guest c u
  if [ ! -f "$src/fffctl" ] || [ ! -f "$src/lib.sh" ]; then warn "release $(basename "$1") has no deploy/vm/guest scripts; fffctl and its helpers stay as they are"; return 0; fi
  if ! c=$(install_scripts "$src"); then warn "installing fffctl and its helpers from $(basename "$1") failed"; return 0; fi
  [ -z "$c" ] || log "fffctl and its helpers from $(basename "$1"): updated $c"
  # New machines or host keys in machines.ssh (w537): the portal's ssh aliases and pinned keys follow.
  case " $c " in
    *" machines.ssh "* | *" fff-machine-ssh "*)
      as_fff "$FFF_LIB/fff-machine-ssh" --fix || warn "fff-machine-ssh: not every machine answers (above); the aliases and pinned keys are written" ;;
  esac
  for u in "$src"/units/*; do
    [ -f "$u" ] || continue
    if ! cmp -s "$u" "/etc/systemd/system/$(basename "$u")"; then
      warn "systemd units changed in $(basename "$1") (first: $(basename "$u")): run sudo ~/ff-factory/deploy/vm/guest/install.sh from a clone at that commit to install them"
      break
    fi
  done
}

switch_to() {
  local dir=$1 cur
  cur=$(current_dir)
  [ "$cur" = "$dir" ] && return 0
  [ -z "$cur" ] || ln -sfn "$cur" "$PREVIOUS.new"
  [ -z "$cur" ] || mv -Tf "$PREVIOUS.new" "$PREVIOUS"
  ln -sfn "$dir" "$CURRENT.new"
  mv -Tf "$CURRENT.new" "$CURRENT"
  chown -h "$FFF_USER:$FFF_USER" "$CURRENT" "$PREVIOUS" 2>/dev/null || true
}

cmd_request() {
  local wanted=$DATA/update.wanted drain=10 reason='update' dir sha cur_sha
  if [ -f "$wanted" ]; then
    drain=$(jq -r '.drainMinutes // 10' "$wanted" 2>/dev/null || echo 10)
    reason=$(jq -r '.reason // "update"' "$wanted" 2>/dev/null || echo update)
    rm -f "$wanted"
  fi
  log "update requested ($reason): building origin/$FFF_BRANCH beside the running server"
  # The build's output goes to the journal as it happens (fffctl update shows each step from there) and to the build
  # log, whose last lines a failure reports.
  local buildlog=$APP/last-build.log out=$APP/.prepared-dir
  rm -f "$out"
  if ! prepare "origin/$FFF_BRANCH" 2>&1 >"$out" | tee "$buildlog" >&2; then
    tell_dispatcher "[app update] The update was NOT done: building origin/$FFF_BRANCH failed, so nothing was restarted and the running version stays. Last lines (journalctl -u fff-update in the VM for all):
$(tail -n 12 "$buildlog")"
    exit 1
  fi
  dir=$(cat "$out")
  rm -f "$out"
  sha=$(release_sha "$dir")
  cur_sha=$(release_sha "$(current_dir)")
  if [ "$sha" = "$cur_sha" ]; then
    log "already at ${sha:0:12}; nothing to restart"
    refresh_scripts "$(current_dir)"
    tell_dispatcher "[app update] Already up to date at ${sha:0:9} (origin/$FFF_BRANCH); nothing was restarted."
    return 0
  fi
  jq -n --arg sha "$sha" --arg dir "$dir" --arg at "$(date -u +%FT%TZ)" '{sha: $sha, dir: $dir, at: $at}' | data_write update.prepared.json
  jq -n --argjson m "$drain" --arg r "update to ${sha:0:9} ($reason)" '{drain: "auto", drainMinutes: $m, reason: $r, update: true, hold: false}' |
    data_write restart.request
  log "built ${sha:0:12}; asked the server to drain (up to $drain min) and restart"
}

cmd_activate() {
  local req=$DATA/update.request dir="" before after err=""
  [ -f "$req" ] || exit 0
  rm -f "$req"
  before=$(release_sha "$(current_dir)")
  dir=$(jq -r '.dir // empty' "$DATA/update.prepared.json" 2>/dev/null || true)
  if [ -z "$dir" ] || [ ! -f "$dir.ready" ]; then
    # An update the server handed over without a prepared release: one cut off by a crash (server/index.ts), or an
    # old-style request. Build it now, while the portal is down.
    log "no prepared release: building origin/$FFF_BRANCH now (the portal is down meanwhile)"
    dir=$(prepare "origin/$FFF_BRANCH") || { dir=""; err="building origin/$FFF_BRANCH failed (journalctl -u fff-portal in the VM)"; }
  fi
  rm -f "$DATA/update.prepared.json"
  if [ -n "$dir" ]; then
    switch_to "$dir"
    refresh_scripts "$dir"
    after=$(release_sha "$dir")
    jq -n --arg at "$(date -u +%FT%TZ)" --arg b "$before" --arg a "$after" '{ok: true, at: $at, headBefore: $b, headAfter: $a}' | data_write update.result.json
    if [ "$after" != "$before" ]; then
      jq -n --arg sha "$after" --arg prev "$before" --argjson d "$(($(date +%s) + $(verify_secs)))" '{sha: $sha, previous: $prev, deadline: $d}' |
        data_write update.verifying.json
    fi
    log "switched ${before:0:12} -> ${after:0:12}; verifying for $(verify_secs) s"
    prune || warn "pruning old releases failed"
  else
    jq -n --arg at "$(date -u +%FT%TZ)" --arg b "$before" --arg e "$err" '{ok: false, at: $at, error: $e, headBefore: $b, headAfter: $b}' | data_write update.result.json
    log "update failed: $err; starting ${before:0:12} again"
  fi
}

cmd_rollback() {
  local why=${1:-asked for by hand} cur prev cur_sha prev_sha
  cur=$(current_dir); prev=$(readlink -e "$PREVIOUS" 2>/dev/null || true)
  if [ -z "$prev" ] || [ ! -f "$prev.ready" ]; then die "no previous release to go back to"; fi
  cur_sha=$(release_sha "$cur"); prev_sha=$(release_sha "$prev")
  ln -sfn "$prev" "$CURRENT.new" && mv -Tf "$CURRENT.new" "$CURRENT"
  ln -sfn "$cur" "$PREVIOUS.new" && mv -Tf "$PREVIOUS.new" "$PREVIOUS"
  refresh_scripts "$prev"
  rm -f "$DATA/update.verifying.json"
  jq -n --arg at "$(date -u +%FT%TZ)" --arg b "$cur_sha" --arg a "$prev_sha" --arg e "rolled back: $why" \
    '{ok: false, at: $at, error: $e, headBefore: $b, headAfter: $a}' | data_write update.result.json
  tell_dispatcher "[app update] Rolled back from ${cur_sha:0:9} to ${prev_sha:0:9}: $why. Data files are not rolled back (formats only move forward); the host's disk snapshots hold older states."
  log "rolled back ${cur_sha:0:12} -> ${prev_sha:0:12}: $why; restarting the portal"
  systemctl restart fff-portal.service
}

cmd_verify() {
  local f=$DATA/update.verifying.json sha deadline got
  [ -f "$f" ] || return 0
  sha=$(jq -r .sha "$f"); deadline=$(jq -r .deadline "$f")
  got=$(health_json 2>/dev/null | jq -r '.sha // empty' 2>/dev/null || true)
  if [ -n "$got" ] && [ "${sha:0:${#got}}" = "$got" ]; then
    rm -f "$f"
    log "update to ${sha:0:12} verified: the portal answers with it"
    return 0
  fi
  if [ "$(date +%s)" -gt "$deadline" ]; then
    cmd_rollback "the new version ${sha:0:9} did not answer /api/health within $(verify_secs) s of its start"
  fi
}

cmd_init() {
  local ref=${1:-origin/$FFF_BRANCH} dir
  install -d -m 0700 -o "$FFF_USER" -g "$FFF_USER" "$APP" "$RELEASES"
  if [ ! -d "$REPO" ]; then
    log "cloning $FFF_REPO_URL"
    as_fff git clone --bare --quiet "$FFF_REPO_URL" "$REPO"
    as_fff git -C "$REPO" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
  fi
  as_fff git -C "$REPO" remote set-url origin "$FFF_REPO_URL"
  dir=$(prepare "$ref")
  if [ -z "$(current_dir)" ]; then switch_to "$dir"; log "current release: $(basename "$dir")"; else log "a current release exists ($(basename "$(current_dir)")); updates go through fffctl update"; fi
}

case "${1:-}" in
  request) cmd_request ;;
  activate) cmd_activate ;;
  verify) cmd_verify ;;
  rollback) shift; cmd_rollback "$*" ;;
  prepare) shift; prepare "${1:-}" ;;
  init) shift; cmd_init "${1:-}" ;;
  prune) prune ;;
  *) sed -n '2,27p' "$0"; exit 2 ;;
esac
