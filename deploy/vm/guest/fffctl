#!/usr/bin/env bash
# fffctl: the FF Factory portal inside its VM (deploy/vm/guest; /usr/local/sbin/fffctl). Root (sudo).
#
#   fffctl status                       the portal, its release, health, Tailscale, the base clone, backups
#   fffctl logs [-f]                    the portal's journal
#   fffctl restart [--no-drain] [--drain-minutes N]
#                                       drain busy agents, restart, resume them (restart.ps1's job)
#   fffctl update [--drain-minutes N]   build origin/main beside the running portal, then drain and switch
#                                       (what request_app_update does; restart.ps1 -Update's job)
#   fffctl rollback                     back to the previous release
#   fffctl prepare-shutdown [--drain-minutes N] [--reason TEXT]
#                                       drain, stop the portal and keep it stopped until the next boot (the host's
#                                       nightly restart runs this through the guest agent first)
#   fffctl start                        start the portal again after prepare-shutdown, without a reboot
#   fffctl claude-token --file FILE     Lothsahn's subscription token ("claude setup-token", sk-ant-oat01-...) for the
#                                       orchestrators and the dispatcher (decision D4): stored in $FFF_ROOT/secrets,
#                                       never in config.json or a unit
#   fffctl claude-login                 an interactive claude.ai login instead (not the decided route)
#   fffctl tailscale-join --authkey-file FILE [--hostname fff] [--tag tag:fff-portal]
#                                       join the tailnet as a tagged node and open the Funnel to the portal
#   fffctl gh-login --token-file FILE   the portal's GitHub token (a fine-grained token on a machine user)
#   fffctl base-clone                   clone the game repo for the orchestrators' reads (needs gh-login first)
#   fffctl backup                       an encrypted backup now (fff-backup.timer does it every day)
#   fffctl backup-config --target USER@HOST --recipients-file FILE
#                                       where the backups go (BACKUP_SSH_TARGET in /etc/fff/fff.conf) and the age public
#                                       keys they are encrypted to (/etc/fff/backup-recipients.txt); --target "" turns
#                                       them off
#   fffctl configure [--owner-name NAME] [--public-url URL] [--claude-tokenfile]
#                                       set config.json's ownerName, publicUrl, and the orchestrators and the dispatcher on
#                                       the stored subscription token (claudeTokenFile, claudeAccounts "tokenfile"); the
#                                       portal restarts when it changed
#   fffctl state                        what is set up, as JSON (the host's install.sh reads it to do only what is missing)
#   fffctl vault list | add | rotate | grant | remove ...
#                                       the token vault (docs/vault.md): secrets the portal hands worker runs. A value comes
#                                       from --file FILE or --stdin, never the command line, and is never shown back
#                                       (fffctl vault help)
#   fffctl vault init [--new-key]       make the vault key ($FFF_VAULT_KEY) if missing and restart the portal to load it;
#                                       --new-key replaces it (the old one kept beside it; every entry then needs rotating)
#   fffctl vault export-key --out FILE  a copy of the key for safekeeping (0600, root): docs/vault.md, open decision 2
#   fffctl machine-credential list | issue ID --out FILE | revoke ID
#                                       a machine's own credential (its enrollment): issue writes it to FILE, never the
#                                       screen; revoke cuts the machine off within 20 s (docs/vault.md, section 3)
#   fffctl migrate --key | --dry-run-copy | --rollback-dry-run | --cut-over [--ssh USER@HOST]
#                                       move the portal from BEAST into this VM, pulling its config, data and conversations
#                                       over ssh (deploy/vm/RUNBOOK.md "Dry run" and "Cut-over"; fffctl migrate --help)
set -o errexit -o nounset -o pipefail
# shellcheck source=lib.sh
. "${FFF_LIB:-/usr/local/lib/fff}/lib.sh"
need_root
load_conf
HOLD=/run/fff/portal.hold

restart_request() {
  # $1 drain (auto|false), $2 minutes, $3 reason, $4 update (true|false)
  jq -n --arg d "$1" --argjson m "$2" --arg r "$3" --argjson u "$4" \
    '{drain: (if $d == "false" then false else $d end), drainMinutes: $m, reason: $r, update: $u, hold: false}' | data_write restart.request
}
main_pid() { systemctl show -p MainPID --value fff-portal.service; }
wait_healthy() {
  local secs=$1 _
  for _ in $(seq "$secs"); do health_json >/dev/null 2>&1 && return 0; sleep 1; done
  return 1
}

cmd_status() {
  local cur prev h
  cur=$(readlink -e "$CURRENT" 2>/dev/null || echo none); prev=$(readlink -e "$PREVIOUS" 2>/dev/null || echo none)
  echo "portal: $(systemctl is-active fff-portal.service) (pid $(main_pid))$([ -e "$HOLD" ] && echo ', HELD until reboot (fffctl start)')"
  h=$(health_json 2>/dev/null || echo 'no answer')
  echo "  /api/health: $h"
  echo "  release: $(basename "$cur") ($(release_sha "$cur" || true)); previous: $(basename "$prev")"
  [ ! -f "$DATA/update.verifying.json" ] || echo "  verifying an update: $(cat "$DATA/update.verifying.json")"
  [ ! -f "$DATA/update.result.json" ] || echo "  last update result: $(cat "$DATA/update.result.json")"
  echo "  data: $(du -sh "$DATA" 2>/dev/null | cut -f1); disk: $(df -h --output=avail,pcent "$FFF_ROOT" | tail -n 1 | xargs) free/used"
  echo "tailscale: $(tailscale status --self --peers=false 2>/dev/null | head -n 1 || echo 'not joined')"
  echo "  funnel: $(tailscale funnel status 2>/dev/null | grep -m1 -o 'https://[^ ]*' || echo none)"
  echo "claude login: $([ -s "$FFF_ROOT/home/.claude/.credentials.json" ] && echo stored || echo 'none (fffctl claude-login)')"
  echo "base clone: $([ -d "$BASE_PATH/.git" ] && as_fff git -C "$BASE_PATH" log -1 --format='%h %cr' || echo 'none (fffctl base-clone)')"
  echo "backups: $([ -n "$BACKUP_SSH_TARGET" ] && echo "to $BACKUP_SSH_TARGET:$BACKUP_REMOTE_DIR" || echo off); last: $(journalctl -u fff-backup.service -n 1 --no-pager -o cat 2>/dev/null || true)"
  systemctl list-timers --no-pager 'fff-*' 2>/dev/null | head -n 6
}

cmd_restart() {
  local drain=auto mins=10 before
  while [ $# -gt 0 ]; do
    case "$1" in --no-drain) drain=false ;; --drain-minutes) mins=$2; shift ;; *) die "unknown option $1" ;; esac
    shift
  done
  portal_active || { systemctl start fff-portal.service; wait_healthy 120 && echo "started"; return; }
  before=$(main_pid)
  restart_request "$drain" "$mins" "restart (fffctl)" false
  echo "asked the portal to $([ "$drain" = false ] && echo 'stop now' || echo "drain (up to $mins min)") and restart; waiting"
  for _ in $(seq $(((mins + 3) * 60))); do
    [ "$(main_pid)" != "$before" ] && [ "$(main_pid)" != 0 ] && wait_healthy 120 && { echo "restarted (pid $(main_pid))"; return 0; }
    sleep 1
  done
  die "the portal did not come back; fffctl status, fffctl logs"
}

cmd_update() {
  local mins=10
  while [ $# -gt 0 ]; do case "$1" in --drain-minutes) mins=$2; shift ;; *) die "unknown option $1" ;; esac; shift; done
  jq -n --argjson m "$mins" --arg at "$(date -u +%FT%TZ)" '{drainMinutes: $m, reason: "update (fffctl update)", at: $at}' | data_write update.wanted
  echo "update requested: fff-update builds origin/$FFF_BRANCH now (journalctl -fu fff-update), then the portal drains and switches"
}

cmd_prepare_shutdown() {
  local mins=10 reason="stop (fffctl prepare-shutdown)" t0
  while [ $# -gt 0 ]; do
    case "$1" in --drain-minutes) mins=$2; shift ;; --reason) reason=$2; shift ;; *) die "unknown option $1" ;; esac
    shift
  done
  t0=$(date +%s)
  install -d -m 0755 /run/fff
  touch "$HOLD"
  if portal_active; then
    restart_request auto "$mins" "$reason" false
    # The server drains, records what to resume, stops its agents and exits 0; ExecCondition then keeps systemd
    # from starting it again while the hold file exists.
    for _ in $(seq $(((mins + 2) * 60))); do portal_active || break; sleep 1; done
    if portal_active; then
      echo "no stop after the drain; stopping it (SIGTERM: it still records what to resume)"
      systemctl stop fff-portal.service
    fi
  fi
  echo "portal stopped after $(($(date +%s) - t0)) s; held until the next boot"
}

cmd_claude_login() {
  local claude=$FFF_ROOT/home/.local/bin/claude
  [ -x "$claude" ] || die "no Claude Code CLI at $claude (install.sh installs it)"
  cat <<EOF
Sign in with Lothsahn's claude.ai account, as the portal's account $FFF_USER:
  1. In the Claude Code prompt that opens, type /login and pick the Claude account with a subscription.
  2. Open the URL it shows on any device, sign in, and paste the code back here.
  3. Type /exit.
The login is stored in $FFF_ROOT/home/.claude/.credentials.json (0600, $FFF_USER only). Then set
claudeAccounts.orchestrator (and claudeAccounts.dispatcher, change 6) to "login" (docs/portal-on-ffbox-host.md, 5.2).
EOF
  as_fff bash -c "cd ~ && exec '$claude'" || true
  if [ -s "$FFF_ROOT/home/.claude/.credentials.json" ]; then echo "login stored"; else echo "no login stored"; exit 1; fi
}

cmd_claude_token() {
  local f="" token dest=$FFF_ROOT/secrets/claude-oauth-token tmp
  while [ $# -gt 0 ]; do case "$1" in --file) f=$2; shift ;; *) die "unknown option $1" ;; esac; shift; done
  if [ -z "$f" ] || [ ! -r "$f" ]; then die "--file FILE: the subscription token from 'claude setup-token' (sk-ant-oat01-...), alone in a file (chmod 600)"; fi
  token=$(head -n 1 "$f" | tr -d '[:space:]')
  case "$token" in sk-ant-oat01-*) ;; *) die "that is not a 'claude setup-token' token (they start sk-ant-oat01-)" ;; esac
  install -d -m 0700 -o "$FFF_USER" -g "$FFF_USER" "$FFF_ROOT/secrets"
  tmp=$(mktemp "$FFF_ROOT/secrets/.token.XXXXXX")
  printf '%s\n' "$token" >"$tmp"
  chown "$FFF_USER:$FFF_USER" "$tmp"
  chmod 0600 "$tmp"
  mv -f "$tmp" "$dest"
  # Only its last four characters are ever shown.
  echo "stored in $dest (0600, $FFF_USER), ending ...${token: -4}. Delete $f now."
  echo "The portal uses it for the roles config claudeAccounts sets to \"tokenfile\" (code change 18; docs, 5.2), never for workers."
}

cmd_tailscale_join() {
  local keyfile="" host=fff tag=tag:fff-portal url
  while [ $# -gt 0 ]; do
    case "$1" in --authkey-file) keyfile=$2; shift ;; --hostname) host=$2; shift ;; --tag) tag=$2; shift ;; *) die "unknown option $1" ;; esac
    shift
  done
  if [ -z "$keyfile" ] || [ ! -r "$keyfile" ]; then
    die "--authkey-file FILE: a tagged ($tag), pre-approved, non-ephemeral auth key from the tailnet's admin console, in a file (chmod 600); it is read from the file, never from the command line"
  fi
  # file: keeps the key off the command line, where any process could read it.
  tailscale up --auth-key="file:$keyfile" --hostname="$host" --advertise-tags="$tag"
  tailscale set --auto-update
  tailscale funnel --bg "http://127.0.0.1:$FFF_PORT"
  url=$(tailscale funnel status 2>/dev/null | grep -m1 -o 'https://[^ ]*' || true)
  echo "joined as $host ($tag). Funnel: ${url:-see tailscale funnel status}"
  echo "Delete $keyfile now. Then set config.json publicUrl to ${url%/} (or set_app_config publicUrl)."
}

cmd_gh_login() {
  local tf=""
  while [ $# -gt 0 ]; do case "$1" in --token-file) tf=$2; shift ;; *) die "unknown option $1" ;; esac; shift; done
  if [ -z "$tf" ] || [ ! -r "$tf" ]; then die "--token-file FILE: the portal's fine-grained GitHub token (decision D7), in a file"; fi
  as_fff gh auth login --hostname github.com --with-token <"$tf"
  as_fff gh auth setup-git --hostname github.com
  as_fff gh auth status --hostname github.com 2>&1 | grep -v -i token || true
  echo "Delete $tf now."
}

cmd_base_clone() {
  if [ -d "$BASE_PATH/.git" ]; then echo "base clone exists at $BASE_PATH ($(as_fff git -C "$BASE_PATH" log -1 --format='%h %cr'))"; return 0; fi
  install -d -m 0700 -o "$FFF_USER" -g "$FFF_USER" "$(dirname "$BASE_PATH")"
  echo "cloning $BASE_REPO_URL ($BASE_BRANCH) into $BASE_PATH without LFS files"
  as_fff git clone --quiet --branch "$BASE_BRANCH" "$BASE_REPO_URL" "$BASE_PATH"
  as_fff git -C "$BASE_PATH" checkout --quiet --detach "origin/$BASE_BRANCH"
  systemctl start fff-base-refresh.timer
  echo "done: $(du -sh "$BASE_PATH" | cut -f1)"
}

# The vault and machine credentials, through the portal's own code (server/vaultCli.ts) in the current release, as root:
# it reads the key file directly and gives what it writes to the fff user.
vault_cli() {
  [ -e "$CURRENT/server/vaultCli.ts" ] || die "the current release has no vault (fffctl update first)"
  (cd "$CURRENT" && FFF_VAULT_KEY_FILE=$FFF_VAULT_KEY FFSB_CONFIG=$FFF_ROOT/config/config.json node server/vaultCli.ts "$@")
}

cmd_vault() {
  case "${1:-list}" in
    init)
      local fresh=0
      [ "${2:-}" = --new-key ] && fresh=1
      if [ -s "$FFF_VAULT_KEY" ] && [ "$fresh" = 0 ]; then
        echo "the vault key exists ($FFF_VAULT_KEY)"
      else
        [ ! -s "$FFF_VAULT_KEY" ] || cp -p "$FFF_VAULT_KEY" "$FFF_VAULT_KEY.old-$(date -u +%Y%m%dT%H%M%SZ)"
        (umask 077 && head -c 32 /dev/urandom | base64 >"$FFF_VAULT_KEY.tmp")
        chmod 0600 "$FFF_VAULT_KEY.tmp"
        mv -f "$FFF_VAULT_KEY.tmp" "$FFF_VAULT_KEY"
        echo "a new vault key in $FFF_VAULT_KEY (0600, root; its content is not shown)"
      fi
      # systemd hands the key over at start (LoadCredential=): a restart loads a new one.
      cmd_restart --drain-minutes 2
      vault_cli list | head -n 1
      ;;
    export-key)
      [ "${2:-}" = --out ] && [ -n "${3:-}" ] || die "fffctl vault export-key --out FILE"
      [ -s "$FFF_VAULT_KEY" ] || die "no vault key yet (fffctl vault init)"
      [ ! -e "$3" ] || die "$3 exists; pick a new file"
      install -m 0600 -o root -g root "$FFF_VAULT_KEY" "$3"
      echo "a copy of the vault key in $3 (0600, root). Keep it where docs/vault.md (open decision 2) says, then delete $3."
      ;;
    help | -h | --help) sed -n '2,15p' "$CURRENT/server/vaultCli.ts" ;;
    *) vault_cli "$@" ;;
  esac
}

# What is set up, as one JSON object: the host's install.sh (deploy/vm/host/guest.sh) reads it to do only what is missing.
cmd_state() {
  local ts='{}' cfg=$FFF_ROOT/config/config.json joined=false ip="" funnel="" gh=false nkeys
  # grep -c prints 0 and fails when nothing matches: no "|| echo 0" after it, or the count is printed twice.
  nkeys=$(grep -c '^age1' "$BACKUP_RECIPIENTS_FILE" 2>/dev/null || true)
  ts=$(tailscale status --json 2>/dev/null || echo '{}')
  [ "$(jq -r '.BackendState // ""' <<<"$ts")" = Running ] && joined=true
  ip=$(jq -r '(.Self.TailscaleIPs // [])[] | select(test("^[0-9.]+$"))' <<<"$ts" 2>/dev/null | head -n 1 || true)
  funnel=$(tailscale funnel status 2>/dev/null | grep -m1 -o 'https://[^ ]*' || true)
  as_fff gh auth status --hostname github.com >/dev/null 2>&1 && gh=true
  jq -n \
    --argjson installed "$([ -x "$FFF_LIB/fff-update" ] && [ -e "$CURRENT" ] && echo true || echo false)" \
    --argjson active "$(portal_active && echo true || echo false)" \
    --argjson healthy "$(health_json >/dev/null 2>&1 && echo true || echo false)" \
    --argjson token "$([ -s "$FFF_ROOT/secrets/claude-oauth-token" ] && echo true || echo false)" \
    --argjson vaultKey "$([ -s "$FFF_VAULT_KEY" ] && echo true || echo false)" \
    --argjson joined "$joined" --arg ip "$ip" --arg funnel "${funnel%/}" --argjson gh "$gh" \
    --argjson base "$([ -d "$BASE_PATH/.git" ] && echo true || echo false)" \
    --argjson config "$(jq -c '{ownerName: (.ownerName // ""), publicUrl: (.publicUrl // ""), tokenfile: ((.claudeTokenFile // "") != "" and (.claudeAccounts.orchestrator // "") == "tokenfile" and (.claudeAccounts.dispatcher // "") == "tokenfile")}' "$cfg" 2>/dev/null || echo '{}')" \
    --arg target "$BACKUP_SSH_TARGET" \
    --argjson recipients "${nkeys:-0}" \
    '{installed: $installed, portal: {active: $active, healthy: $healthy}, claudeToken: $token, vaultKey: $vaultKey,
      tailscale: {joined: $joined, ip: $ip, funnelUrl: $funnel}, github: $gh, baseClone: $base, config: $config,
      backup: {target: $target, recipients: $recipients}}'
}

# config.json's ownerName, publicUrl and the token-file accounts, set by the host's install.sh; restarts if it changed.
cmd_configure() {
  local owner="" url="" tokenfile=0 set_owner=0 set_url=0 cfg=$FFF_ROOT/config/config.json tmp
  while [ $# -gt 0 ]; do
    case "$1" in
      --owner-name) owner=$2; set_owner=1; shift ;;
      --public-url) url=$2; set_url=1; shift ;;
      --claude-tokenfile) tokenfile=1 ;;
      *) die "unknown option $1" ;;
    esac
    shift
  done
  [ -f "$cfg" ] || die "no $cfg: run deploy/vm/guest/install.sh first"
  if [ "$tokenfile" = 1 ] && [ ! -s "$FFF_ROOT/secrets/claude-oauth-token" ]; then die "no stored subscription token: fffctl claude-token --file FILE first"; fi
  tmp=$(mktemp "$FFF_ROOT/config/.config.XXXXXX")
  jq --arg owner "$owner" --argjson so "$set_owner" --arg url "$url" --argjson su "$set_url" --argjson tf "$tokenfile" \
    --arg file "$FFF_ROOT/secrets/claude-oauth-token" \
    '(if $so == 1 then .ownerName = $owner else . end)
     | (if $su == 1 then .publicUrl = $url else . end)
     | (if $tf == 1 then .claudeTokenFile = $file | .claudeAccounts = ((.claudeAccounts // {}) + {orchestrator: "tokenfile", dispatcher: "tokenfile"}) else . end)' \
    "$cfg" >"$tmp" || { rm -f "$tmp"; die "could not edit $cfg"; }
  chown "$FFF_USER:$FFF_USER" "$tmp"
  chmod 0600 "$tmp"
  if cmp -s "$tmp" "$cfg"; then rm -f "$tmp"; echo "config.json: unchanged"; return 0; fi
  mv -f "$tmp" "$cfg"
  echo "config.json:$([ "$set_owner" = 0 ] || echo " ownerName $owner;")$([ "$set_url" = 0 ] || echo " publicUrl ${url:-(none)};")$([ "$tokenfile" = 0 ] || echo ' orchestrators and dispatcher on the subscription token;') restarting"
  cmd_restart --drain-minutes 2
}

# Where the backups go and who can open them.
cmd_backup_config() {
  local target="" rf="" set_target=0 tmp
  while [ $# -gt 0 ]; do
    case "$1" in --target) target=$2; set_target=1; shift ;; --recipients-file) rf=$2; shift ;; *) die "unknown option $1" ;; esac
    shift
  done
  if [ -n "$rf" ]; then
    [ -r "$rf" ] || die "--recipients-file $rf: not readable"
    grep -Eq '^age1[0-9a-z]{58}$' "$rf" || die "$rf holds no age public key (age1...)"
    grep -E '^age1[0-9a-z]{58}$' "$rf" | write_file "$BACKUP_RECIPIENTS_FILE" 0644 >/dev/null
    echo "backup recipients: $(grep -c '^age1' "$BACKUP_RECIPIENTS_FILE") age key(s) in $BACKUP_RECIPIENTS_FILE"
  fi
  if [ "$set_target" = 1 ]; then
    case "$target" in "" | [A-Za-z0-9._-]*@[A-Za-z0-9._-]*) ;; *) die "--target is user@host (or \"\" for off), not '$target'" ;; esac
    tmp=$(mktemp)
    { grep -v '^BACKUP_SSH_TARGET=' "$FFF_CONF" 2>/dev/null || true; echo "BACKUP_SSH_TARGET=$target"; } >"$tmp"
    install -m 0644 "$tmp" "$FFF_CONF"
    rm -f "$tmp"
    echo "backups: $([ -n "$target" ] && echo "to $target" || echo off) ($FFF_CONF)"
  fi
}

case "${1:-status}" in
  status) cmd_status ;;
  logs) shift; exec journalctl -u fff-portal.service -u fff-update.service -u fff-health.service --no-pager -n 200 "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  update) shift; cmd_update "$@" ;;
  rollback) exec "$FFF_LIB/fff-update" rollback "asked for by hand (fffctl rollback)" ;;
  prepare-shutdown) shift; cmd_prepare_shutdown "$@" ;;
  start) rm -f "$HOLD"; systemctl start fff-portal.service; wait_healthy 180 && echo "portal up" ;;
  claude-token) shift; cmd_claude_token "$@" ;;
  claude-login) cmd_claude_login ;;
  tailscale-join) shift; cmd_tailscale_join "$@" ;;
  gh-login) shift; cmd_gh_login "$@" ;;
  base-clone) cmd_base_clone ;;
  backup) exec systemctl start --wait fff-backup.service ;;
  backup-config) shift; cmd_backup_config "$@" ;;
  configure) shift; cmd_configure "$@" ;;
  state) cmd_state ;;
  migrate) shift; exec "$FFF_LIB/fff-migrate" "$@" ;;
  vault) shift; cmd_vault "$@" ;;
  machine-credential) shift; vault_cli machine-credential "$@" ;;
  -h | --help | help) sed -n '2,45p' "$0" ;;
  *) die "unknown command $1 (fffctl help)" ;;
esac
