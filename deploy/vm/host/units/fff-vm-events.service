[Unit]
Description=fff-vm: alerts on the FF Factory portal VM's watchdog, crash and unexpected stop events
Documentation=https://github.com/Final-Factory/ff-factory/blob/main/docs/portal-on-ffbox-host.md
After=libvirtd.service virtqemud.service

[Service]
ExecStart=/usr/local/sbin/fff-vm events
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
