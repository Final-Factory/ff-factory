{
  "port": 8790,
  "host": "0.0.0.0",
  "publicUrl": "",
  "ownerName": "",
  "usagePollMinutes": 15,
  "dataDir": "./data",
  "sandboxRoot": "C:/ffsb",
  "repo": {
    "url": "https://github.com/your-org/your-unity-game.git",
    "basePath": "C:/ffsb/_base",
    "referenceRepo": "C:/path/to/your/existing/clone"
  },
  "defaultBase": "origin/develop",
  "unity": {
    "mcpServer": {
      "command": "uvx",
      "args": [
        "--offline",
        "--from",
        "mcpforunityserver==10.0.0",
        "mcp-for-unity"
      ]
    }
  },
  "protectedPaths": [
    "C:/path/to/a/checkout/agents/must/not/touch"
  ],
  "limits": {
    "minFreeRamGB": 10
  },
  "models": [
    "opus",
    "sonnet",
    "haiku",
    "fable"
  ],
  "defaultModel": "sonnet",
  "orchestrator": {
    "model": "opus",
    "effort": "medium",
    "notifyOnWorkerEvents": true,
    "compactAtTokens": 200000,
    "compactAtTurnUsd": 1
  },
  "worker": {
    "permissionMode": "bypassPermissions",
    "effort": "high"
  },
  "hostDiskPaths": [
    "C:/"
  ],
  "providers": {
    "ffbox": {
      "enabled": false,
      "sendWork": false,
      "devRequests": {
        "enabled": true,
        "perHour": 20,
        "maxFiles": 10,
        "maxRequestMB": 500
      }
    }
  },
  "ledger": {
    "cleanup": { "enabled": true, "everyHours": 4 }
  },
  "intake": {
    "discord": {
      "enabled": false,
      "bugChannels": [],
      "requestChannels": [
        "dev_chat"
      ],
      "trusted": {},
      "dailyCap": 10,
      "perReporterPerDay": 2,
      "autoApprove": {
        "enabled": false,
        "maxPerDay": 3
      }
    },
    "ffbox": {
      "enabled": false,
      "boardCheck": false,
      "escalations": false
    },
    "release": {
      "enabled": false,
      "delayMinutes": 60
    },
    "reviewers": []
  },
  "hostGuard": {
    "warnFreeGB": 80,
    "criticalFreeGB": 40,
    "remountMinFreeGB": 30,
    "devDriveVhdx": "",
    "cleanup": {
      "ageRules": []
    }
  }
}
